# =============================================================================
# ~/.bashrc — interactive shell config (managed by chezmoi)
# =============================================================================

# Source global definitions (Fedora ships these)
[ -f /etc/bashrc ] && . /etc/bashrc

# Bail out for non-interactive shells
case $- in
    *i*) ;;
    *) return ;;
esac

# ---- Default editor --------------------------------------------------------
export EDITOR="geany -i"

# ---- History ---------------------------------------------------------------
HISTCONTROL=ignoreboth:erasedups
HISTSIZE=10000
HISTFILESIZE=20000
shopt -s histappend
shopt -s checkwinsize

# ---- PATH additions --------------------------------------------------------
# Ensure ~/.local/bin is on PATH (chezmoi, starship, etc.)
case ":$PATH:" in
    *":$HOME/.local/bin:"*) ;;
    *) export PATH="$HOME/.local/bin:$PATH" ;;
esac

# ---- Color support ---------------------------------------------------------
if [ -x /usr/bin/dircolors ]; then
    test -r ~/.dircolors && eval "$(dircolors -b ~/.dircolors)" || eval "$(dircolors -b)"
    alias ls='ls --color=auto'
    alias grep='grep --color=auto'
    alias fgrep='fgrep --color=auto'
    alias egrep='egrep --color=auto'
fi

# ---- Aliases ---------------------------------------------------------------
alias ll='ls -alF'
alias la='ls -A'
alias l='ls -CF'

# Source per-user aliases if present
[ -f ~/.bash_aliases ] && . ~/.bash_aliases

# ---- Bash completion -------------------------------------------------------
if ! shopt -oq posix; then
    if [ -f /usr/share/bash-completion/bash_completion ]; then
        . /usr/share/bash-completion/bash_completion
    fi
fi

# ---- Prompt: starship ------------------------------------------------------
# Configured in ~/.config/starship.toml (Rize-themed)
if command -v starship >/dev/null 2>&1; then
    eval "$(starship init bash)"
else
    # Fallback to old pink prompt if starship is missing
    PS1='\[\033[38;5;207m\]\u:\w\$\[\033[00m\] '
fi
